# Supabase — copy to .env.local and fill in.
# Project ref + anon key: dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role: server-side only — used for admin actions (Phase 4)
# Never commit. Keep out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet — server only. Keep disabled until every certificate and the
# official localized Apple badge SVG are ready.
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_BASE64=
WALLET_DOWNLOAD_SECRET=

# Download the localized SVG from Apple's Wallet resources, place it under
# public/, and enter its public path here (for example /wallet/add-to-apple-wallet-ko.svg).
APPLE_WALLET_BADGE_PATH=
